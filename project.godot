; MonsterCraft: Voxel Adventure
config_version=5

[application]

config/name="MonsterCraft: Voxel Adventure"
config/description="Open-world voxel sandbox with original monsters, mining, crafting and taming. Fully offline."
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.055, 0.06, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Content="*res://src/content/Content.gd"
Game="*res://src/game/Game.gd"
Sfx="*res://src/game/Sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true
mouse_cursor/custom_image=""

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_subpixel_positioning=1
common/snap_controls_to_pixels=true
font/antialiasing=1

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0
}

[physics]

3d/default_gravity=24.0
common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.48, 0.72, 0.82, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
limits/time/time_rollover_secs=999999

[audio]

buses/default_bus_layout=""

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
